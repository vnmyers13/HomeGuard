{
  "document": "OpenDataRemoval Privacy Platform \u2014 Broker Playbook JSON Schema",
  "version": "1.0",
  "schema_version_value": "1.0",
  "file_location": "playbooks/brokers/{canonical_domain}.json",
  "json_schema_location": "playbooks/schema.json",
  "design_principles": {
    "phase_based": "Organised into named phases \u2014 search, identify, optout, verify, email_loop",
    "action_driven": "Each step declares one action type mapped to a Playwright API call",
    "token_interpolation": "Profile PII injected via {token} syntax at execution time",
    "graceful_degradation": "Each phase/step declares on_failure: stop|skip_phase|mark_manual"
  },
  "top_level_properties": {
    "schema_version": {
      "type": "string",
      "required": true,
      "value": "1.0"
    },
    "broker_domain": {
      "type": "string",
      "required": true,
      "description": "Must match registry.brokers.canonical_domain"
    },
    "display_name": {
      "type": "string",
      "required": true
    },
    "playbook_version": {
      "type": "integer",
      "required": true,
      "description": "Monotonically increasing per broker"
    },
    "complexity": {
      "type": "string",
      "required": true,
      "enum": [
        "simple",
        "multi_step",
        "complex"
      ]
    },
    "dry_run": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Skip all submit actions when true"
    },
    "captcha_strategy": {
      "type": "string",
      "required": false,
      "default": "manual",
      "enum": [
        "manual",
        "2captcha",
        "anticaptcha"
      ],
      "description": "Upgradeable per-broker without schema change"
    },
    "captcha_api_key_env": {
      "type": "string",
      "required": false,
      "description": "Env var name for CAPTCHA solver API key"
    },
    "user_agent_override": {
      "type": "string",
      "required": false,
      "description": "Omit to use executor rotation"
    },
    "request_delay_ms": {
      "type": "object",
      "required": false,
      "properties": {
        "min": "integer>=500",
        "max": "integer>=1000"
      },
      "description": "Overrides global PLAYWRIGHT delay env vars"
    },
    "notes": {
      "type": "string",
      "required": false
    },
    "phases": {
      "type": "array",
      "required": true,
      "description": "Ordered phase objects"
    },
    "confirmation": {
      "type": "object",
      "required": true,
      "description": "Text and URL confirmation detection"
    },
    "captcha_detection": {
      "type": "object",
      "required": false,
      "description": "Selectors and text indicators for CAPTCHA"
    },
    "error_patterns": {
      "type": "array",
      "required": false,
      "description": "Soft error detection patterns"
    }
  },
  "phases": {
    "available_phases": [
      {
        "phase": "search",
        "complexity": [
          "simple",
          "multi_step",
          "complex"
        ],
        "purpose": "Navigate to broker and search for profile by name/location"
      },
      {
        "phase": "identify",
        "complexity": [
          "multi_step",
          "complex"
        ],
        "purpose": "Find and click correct listing from search results"
      },
      {
        "phase": "optout",
        "complexity": [
          "simple",
          "multi_step",
          "complex"
        ],
        "purpose": "Fill and submit the opt-out form"
      },
      {
        "phase": "verify",
        "complexity": [
          "simple",
          "multi_step",
          "complex"
        ],
        "purpose": "Detect confirmation signal"
      },
      {
        "phase": "email_loop",
        "complexity": [
          "complex"
        ],
        "purpose": "Poll inbox for verification link and click it"
      }
    ],
    "phase_properties": {
      "phase": {
        "type": "string",
        "required": true,
        "enum": [
          "search",
          "identify",
          "optout",
          "verify",
          "email_loop"
        ]
      },
      "description": {
        "type": "string",
        "required": true
      },
      "url_template": {
        "type": "string",
        "required": false,
        "description": "Navigates here at phase start. Tokens interpolated."
      },
      "on_failure": {
        "type": "string",
        "required": false,
        "default": "stop",
        "enum": [
          "stop",
          "skip_phase",
          "mark_manual"
        ]
      },
      "timeout_ms": {
        "type": "integer",
        "required": false,
        "default": 30000
      },
      "steps": {
        "type": "array",
        "required": true,
        "description": "Ordered step objects"
      }
    }
  },
  "steps": {
    "step_properties": {
      "id": {
        "type": "string",
        "required": true,
        "pattern": "^step_[a-z0-9_]+$"
      },
      "description": {
        "type": "string",
        "required": true
      },
      "action": {
        "type": "string",
        "required": true,
        "description": "See action_types below"
      },
      "selector": {
        "type": "string",
        "required": "depends",
        "description": "CSS or XPath selector"
      },
      "value": {
        "type": "string",
        "required": "depends",
        "description": "URL, fill value, JS expression. Tokens interpolated."
      },
      "values": {
        "type": "object",
        "required": "depends",
        "description": "fill_form map: { selector: value }"
      },
      "patterns": {
        "type": "array",
        "required": "depends",
        "description": "Text patterns for assert/wait_for_text"
      },
      "url_pattern": {
        "type": "string",
        "required": "depends",
        "description": "Regex for wait_for_navigation/assert_url"
      },
      "timeout_ms": {
        "type": "integer",
        "required": false
      },
      "optional": {
        "type": "boolean",
        "required": false,
        "default": false
      },
      "screenshot": {
        "type": "boolean",
        "required": false,
        "default": false
      },
      "dry_run_skip": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "ONLY submit action uses this"
      },
      "on_failure": {
        "type": "string",
        "required": false,
        "enum": [
          "stop",
          "skip_step",
          "mark_manual"
        ]
      },
      "wait_after_ms": {
        "type": "integer",
        "required": false
      },
      "steps": {
        "type": "array",
        "required": "conditional only",
        "description": "Nested steps for conditional action"
      },
      "notes": {
        "type": "string",
        "required": false
      }
    },
    "action_types": {
      "navigate": {
        "params": "value (URL)",
        "description": "Navigate browser to URL. Tokens interpolated."
      },
      "fill": {
        "params": "selector, value",
        "description": "Fill input. Clears existing content first."
      },
      "fill_form": {
        "params": "values (object)",
        "description": "Fill multiple fields: { '#selector': 'value' }"
      },
      "click": {
        "params": "selector",
        "description": "Click element. Waits for visibility first."
      },
      "select": {
        "params": "selector, value",
        "description": "Select <select> option by value or visible text"
      },
      "wait_for_selector": {
        "params": "selector",
        "description": "Wait until selector visible in DOM"
      },
      "wait_for_navigation": {
        "params": "url_pattern",
        "description": "Wait for page to navigate to matching URL"
      },
      "wait_for_text": {
        "params": "patterns",
        "description": "Wait until any text pattern appears in page body"
      },
      "screenshot": {
        "params": "(none)",
        "description": "Capture screenshot. Always stored."
      },
      "assert_text": {
        "params": "patterns",
        "description": "Assert at least one pattern on page \u2014 fails if none"
      },
      "assert_url": {
        "params": "url_pattern",
        "description": "Assert current URL matches regex"
      },
      "assert_not_found": {
        "params": "selector",
        "description": "Assert selector NOT present \u2014 confirm removal"
      },
      "scroll": {
        "params": "selector (optional)",
        "description": "Scroll to selector or to page bottom"
      },
      "evaluate": {
        "params": "value (JS expression)",
        "description": "Execute JS in page context"
      },
      "conditional": {
        "params": "selector, steps",
        "description": "Execute nested steps only if selector present"
      },
      "submit": {
        "params": "selector",
        "description": "Click submit button. SKIPPED ENTIRELY when dry_run=true."
      }
    },
    "dry_run_note": "Only the 'submit' action respects dry_run=true. All other actions execute normally."
  },
  "token_interpolation": {
    "syntax": "{token_name}",
    "applies_to": "All string values in phases, steps, confirmation, and error_patterns",
    "tokens": {
      "{full_name}": "identity.profiles.full_legal_name \u2014 e.g. John Robert Smith",
      "{first_name}": "First word of full_legal_name \u2014 e.g. John",
      "{last_name}": "Last word of full_legal_name \u2014 e.g. Smith",
      "{date_of_birth}": "identity.profiles.date_of_birth \u2014 ISO format 1980-05-14",
      "{dob_month}": "Month from date_of_birth \u2014 e.g. 05",
      "{dob_year}": "Year from date_of_birth \u2014 e.g. 1980",
      "{email}": "Current email field \u2014 personal subtype first",
      "{phone}": "Current phone field \u2014 mobile subtype first",
      "{address_full}": "Current home address field_value",
      "{city}": "Parsed city from current address",
      "{state}": "Parsed 2-letter state from current address",
      "{zip}": "Parsed zip from current address",
      "{state_full}": "Parsed full state name from current address",
      "{alias_1}": "First alias from identity.aliases",
      "{removal_email}": "REMOVAL_EMAIL environment variable",
      "{email_verification_link}": "URL extracted from email_loop phase inbox polling"
    },
    "missing_token_behaviour": "Step using unresolvable token is skipped. Warning written to audit_log. Phase continues unless step has optional: false."
  },
  "confirmation_detection": {
    "description": "Both text_patterns and url_patterns evaluated \u2014 whichever fires first triggers confirmed state",
    "properties": {
      "text_patterns": {
        "type": "array",
        "description": "Lowercase strings matched in page.body.toLowerCase()"
      },
      "url_patterns": {
        "type": "array",
        "description": "Regex strings matched against current URL"
      },
      "match_strategy": {
        "type": "string",
        "default": "any",
        "enum": [
          "any",
          "all"
        ],
        "description": "any = first match wins"
      },
      "negative_patterns": {
        "type": "array",
        "description": "If any appear, override confirmation and treat as failure"
      },
      "screenshot_on_confirm": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "captcha_handling": {
    "detection_properties": {
      "selectors": {
        "type": "array",
        "required": true,
        "description": "CSS selectors for CAPTCHA presence"
      },
      "text_indicators": {
        "type": "array",
        "required": false
      },
      "strategy_override": {
        "type": "string",
        "required": false,
        "description": "Override root captcha_strategy"
      }
    },
    "common_captcha_selectors": [
      "#recaptcha",
      ".g-recaptcha",
      ".h-captcha",
      "[data-sitekey]",
      "iframe[src*='recaptcha']",
      "iframe[src*='hcaptcha']"
    ],
    "strategies": {
      "manual": "Stop, flag broker captcha_required=true, create dashboard action item",
      "2captcha": "Submit to 2captcha API \u2014 falls back to manual on failure",
      "anticaptcha": "Submit to Anti-Captcha API \u2014 falls back to manual on failure"
    }
  },
  "error_patterns": {
    "description": "Soft error detection \u2014 catches errors that don't throw Playwright exceptions",
    "item_properties": {
      "type": {
        "enum": [
          "text",
          "url"
        ]
      },
      "pattern": {
        "type": "string"
      },
      "action": {
        "enum": [
          "stop",
          "mark_not_found",
          "rate_limited",
          "captcha_detected"
        ]
      }
    }
  },
  "complexity_levels": {
    "simple": {
      "phases": [
        "optout",
        "verify"
      ],
      "description": "Direct opt-out form \u2014 no search required",
      "example_broker": "Whitepages"
    },
    "multi_step": {
      "phases": [
        "search",
        "identify",
        "optout",
        "verify"
      ],
      "description": "Search for profile, identify listing, then opt-out",
      "example_broker": "Spokeo"
    },
    "complex": {
      "phases": [
        "search",
        "identify",
        "optout",
        "email_loop",
        "verify"
      ],
      "description": "Includes email verification loop before final removal",
      "example_broker": "BeenVerified"
    }
  },
  "playbook_lifecycle": {
    "validation_points": [
      "On seed import \u2014 scripts/seed_brokers.py rejects invalid JSON Schema",
      "On n8n webhook receipt \u2014 /api/webhooks/n8n validates before upsert, returns 400 on failure",
      "On manual activation \u2014 re-validates before setting is_active=true"
    ],
    "version_lifecycle": {
      "new_playbook": "Insert v1 is_active=true. audit_log: playbook_imported",
      "update": "Insert v(n+1) is_active=true. Prior row is_active=false. audit_log: playbook_updated",
      "rollback": "POST /api/brokers/{id}/playbooks/{pid}/activate. audit_log: playbook_rolled_back",
      "scan_execution": "Playwright fetches active playbook via PLAYWRIGHT_SERVICE_URL before each scan",
      "dry_run_test": "POST /api/scans with dry_run override \u2014 skips all submit actions"
    }
  },
  "formal_json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "OpenDataRemoval Broker Playbook",
    "type": "object",
    "required": [
      "schema_version",
      "broker_domain",
      "display_name",
      "playbook_version",
      "complexity",
      "phases",
      "confirmation"
    ],
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "1.0"
        ]
      },
      "broker_domain": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
      },
      "display_name": {
        "type": "string",
        "minLength": 1
      },
      "playbook_version": {
        "type": "integer",
        "minimum": 1
      },
      "complexity": {
        "type": "string",
        "enum": [
          "simple",
          "multi_step",
          "complex"
        ]
      },
      "dry_run": {
        "type": "boolean"
      },
      "captcha_strategy": {
        "type": "string",
        "enum": [
          "manual",
          "2captcha",
          "anticaptcha"
        ]
      },
      "captcha_api_key_env": {
        "type": "string"
      },
      "user_agent_override": {
        "type": "string"
      },
      "request_delay_ms": {
        "type": "object",
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 500
          },
          "max": {
            "type": "integer",
            "minimum": 1000
          }
        }
      },
      "notes": {
        "type": "string"
      },
      "phases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/phase"
        }
      },
      "confirmation": {
        "$ref": "#/$defs/confirmation"
      },
      "captcha_detection": {
        "$ref": "#/$defs/captcha_detection"
      },
      "error_patterns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/error_pattern"
        }
      }
    }
  }
}