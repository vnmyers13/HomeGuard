"""Screenshot capture with automatic S3 upload."""

import logging
import time
from typing import Optional

from playwright.async_api import Page

logger = logging.getLogger(__name__)


async def capture_screenshot(
    page: Page,
    name: str = "screenshot",
    full_page: bool = True,
) -> bytes:
    """Take a screenshot and return raw PNG bytes.

    Args:
        page: The Playwright page to capture.
        name: Descriptive name (used for logging and S3 key).
        full_page: If True, capture the entire scrollable page.

    Returns:
        Raw PNG bytes of the screenshot.
    """
    timestamp = int(time.time() * 1000)
    safe_name = name.replace("/", "_").replace("\\", "_")

    png_bytes = await page.screenshot(full_page=full_page, type="png")
    logger.info("Screenshot captured: %s (%d bytes)", safe_name, len(png_bytes))
    return png_bytes


async def capture_and_upload(
    page: Page,
    job_id: str,
    name: str = "screenshot",
    full_page: bool = True,
    upload_fn=None,
) -> Optional[str]:
    """Capture a screenshot and upload to S3.

    Args:
        page: The Playwright page to capture.
        job_id: The scan job ID (used for S3 key path).
        name: Descriptive name for the screenshot.
        full_page: If True, capture entire scrollable page.
        upload_fn: Optional async function (bytes, key) -> url for S3 upload.

    Returns:
        S3 URL if upload_fn provided, else None.
    """
    png_bytes = await capture_screenshot(page, name=name, full_page=full_page)

    if upload_fn is None:
        logger.debug("No upload function provided; screenshot not uploaded.")
        return None

    safe_name = name.replace("/", "_").replace("\\", "_")
    key = f"screenshots/{job_id}/{safe_name}.png"

    try:
        url = await upload_fn(png_bytes, key)
        logger.info("Screenshot uploaded: %s -> %s", key, url)
        return url
    except Exception as e:
        logger.error("Failed to upload screenshot %s: %s", key, e)
        return None


def build_s3_key(job_id: str, name: str, extension: str = "png") -> str:
    """Build a standardised S3 key for screenshots and evidence."""
    safe_name = name.replace("/", "_").replace("\\", "_")
    return f"screenshots/{job_id}/{safe_name}.{extension}"