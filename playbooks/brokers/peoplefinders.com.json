{
  "canonical_domain": "peoplefinders.com",
  "complexity": "multi_step",
  "search_url_template": "https://www.peoplefinders.com/search/{full_name}",
  "opt_out_url_template": "https://www.peoplefinders.com/remove",
  "estimated_response_days": 14,
  "phases": [
    {
      "name": "search",
      "url_template": "https://www.peoplefinders.com/search/{full_name}",
      "on_failure": "skip_phase",
      "steps": [
        {"step_id": "nav", "action": "navigate"},
        {"step_id": "wait", "action": "wait", "timeout_ms": 10000},
        {"step_id": "shot", "action": "screenshot"}
      ]
    },
    {
      "name": "opt_out",
      "url_template": "https://www.peoplefinders.com/remove",
      "on_failure": "mark_manual",
      "steps": [
        {"step_id": "nav_out", "action": "navigate"},
        {"step_id": "fill", "action": "fill_form", "selector": "form", "values": {"name": "{full_name}", "email": "{removal_email}"}},
        {"step_id": "submit", "action": "submit"},
        {"step_id": "shot", "action": "screenshot"}
      ]
    }
  ]
}