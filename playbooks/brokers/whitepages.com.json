{
  "canonical_domain": "whitepages.com",
  "complexity": "simple",
  "search_url_template": "https://www.whitepages.com/search?q={full_name}&location={city},{state}",
  "opt_out_url_template": "https://www.whitepages.com/opt-out",
  "estimated_response_days": 7,
  "phases": [
    {
      "name": "search",
      "url_template": "https://www.whitepages.com/search?q={full_name}&location={city},{state}",
      "on_failure": "skip_phase",
      "steps": [
        {"step_id": "navigate_search", "action": "navigate"},
        {"step_id": "wait_results", "action": "wait", "timeout_ms": 8000},
        {"step_id": "screenshot_results", "action": "screenshot"}
      ]
    },
    {
      "name": "opt_out",
      "url_template": "https://www.whitepages.com/opt-out",
      "on_failure": "mark_manual",
      "steps": [
        {"step_id": "navigate_optout", "action": "navigate"},
        {"step_id": "fill_form", "action": "fill_form", "selector": "form", "values": {"full_name": "{full_name}", "email": "{removal_email}"}}
      ]
    }
  ],
  "notes": "Simple opt-out form, name and email sufficient."
}