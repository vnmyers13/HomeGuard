# ============================================================
# HomeGuard Privacy Platform - Environment Configuration
# ============================================================
# Copy this file to .env and replace all CHANGE_ME placeholders
# with actual values. Never commit .env to version control.
# ============================================================

# --------------------------------------------------
# General
# --------------------------------------------------
TIMEZONE=America/New_York
HOST_BIND_ADDRESS=0.0.0.0

# --------------------------------------------------
# Database
# --------------------------------------------------
POSTGRES_DB=homeguard
POSTGRES_USER=homeguard
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://homeguard:CHANGE_ME@db:5432/homeguard
DB_ENCRYPTION_KEY=CHANGE_ME

# --------------------------------------------------
# Redis
# --------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --------------------------------------------------
# Authentication
# --------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_HOURS=8

# --------------------------------------------------
# Email - Mailgun
# --------------------------------------------------
REMOVAL_EMAIL_DOMAIN=CHANGE_ME
REMOVAL_EMAIL=removal@CHANGE_ME
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
IMAP_HOST=imap.mailgun.org
IMAP_PORT=993
IMAP_USER=postmaster@CHANGE_ME
IMAP_PASSWORD=CHANGE_ME
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=900

# --------------------------------------------------
# n8n
# --------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_WEBHOOK_SECRET=CHANGE_ME

# --------------------------------------------------
# Playwright Executor
# --------------------------------------------------
PLAYWRIGHT_SERVICE_URL=http://playwright:8001
PLAYWRIGHT_MIN_DELAY_MS=2000
PLAYWRIGHT_MAX_DELAY_MS=5000
PLAYWRIGHT_PROXY_URL=

# --------------------------------------------------
# Scheduling
# --------------------------------------------------
SCAN_SCHEDULE_CRON=0 2 * * *
SCREENSHOT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --------------------------------------------------
# Bootstrap
# --------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --------------------------------------------------
# Celery
# --------------------------------------------------
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_WORKER_CONCURRENCY=2